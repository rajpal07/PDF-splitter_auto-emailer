rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Login logs collection - users can only access their own logs
    match /login_logs/{logId} {
      // Allow create if authenticated and the user_id matches the auth uid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      
      // Allow read if authenticated and the document's user_id matches auth uid
      // For list queries, the client must filter by user_id (which the app does)
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
    
    // Workflow jobs collection - users can only access their own jobs
    match /workflow_jobs/{jobId} {
      // Allow create if authenticated and the user_id matches the auth uid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      
      // Allow read if authenticated and the document's user_id matches auth uid
      // For list queries, the client must filter by user_id (which the app does)
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
  }
}
